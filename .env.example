DATABASE_URL="file:./dev.db"

# Shared household expenses pushed by home-hub (see README). Use the same key in both apps.
HOME_HUB_SYNC_KEY="generate with: openssl rand -hex 24"
# Name of the user whose expenses these are; optional when there is only one user
HOME_HUB_SYNC_USER=""

# Card-charge SMS forwarded from the phone (see README). Separate from the home-hub key.
SMS_SYNC_KEY="generate with: openssl rand -hex 24"
# Name of the user the SMS expenses belong to (falls back to HOME_HUB_SYNC_USER); required when there is more than one user
SMS_SYNC_USER=""
